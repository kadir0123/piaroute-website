# Vercel Postgres (Vercel Storage bağlayınca otomatik gelir)
# POSTGRES_URL=

# Zorunlu üretimde: IP hash tuzu (rastgele uzun string)
IP_HASH_SALT=change-me-to-a-long-random-string

# İsteğe bağlı bot koruması (Cloudflare Turnstile secret)
# TURNSTILE_SECRET_KEY=

# Üretim origin
ALLOWED_ORIGIN=https://www.piaroute.com

# Preview'dan forma izin (varsayılan kapalı)
# ALLOW_VERCEL_PREVIEW=true

# Saatlik IP başına başvuru limiti
# APPLY_RATE_LIMIT_PER_HOUR=5
